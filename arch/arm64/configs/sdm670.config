# SDM670-specific drivers
CONFIG_PINCTRL_SDM670_LPASS_LPI=m
CONFIG_INTERCONNECT_QCOM_SDM670=y

# Power domain controllers should be built-in
CONFIG_SDM_CAMCC_845=y

# Shared GPIOs (maybe consumed by a pin config and by the user) are proxied
CONFIG_GPIO_SHARED_PROXY=y

# Device panel drivers
CONFIG_DRM_PANEL_NOVATEK_NT37700F=y
CONFIG_DRM_PANEL_SAMSUNG_AMS639RQ08=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3FA7=y
CONFIG_DRM_PANEL_SAMSUNG_SOFEF00_BONITO=y

# Pixel 3a haptics
CONFIG_INPUT_DRV2624_HAPTICS=y

# Pixel 3a NFC
CONFIG_NFC_NXP_NCI=m
CONFIG_NFC_NXP_NCI_I2C=m

# Pixel 3a modemsmem
CONFIG_QCOM_MODEMSMEM=y

# Pixel 3a sound
CONFIG_SND_SOC_CS35L36=m
CONFIG_SND_SOC_MSM8916_WCD_ANALOG=m
CONFIG_SND_SOC_MSM8916_WCD_DIGITAL=m

# Pixel 3a camera
CONFIG_VIDEO_IMX355=m
CONFIG_VIDEO_IMX363=m

# GPU is connected to refgen on linux-next
CONFIG_REGULATOR_QCOM_REFGEN=y

# use in-kernel pd-mapper
CONFIG_QCOM_PD_MAPPER=m

# Branding
CONFIG_LOCALVERSION="-sdm670"

# Support zswap if enabled explicitly
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=n
CONFIG_ZSWAP_DEFAULT_COMPRESSOR_ZSTD=y

# Changes made in pmaports, still not in vendored SDM845 config
CONFIG_RMI4_SPI=m
CONFIG_RMI4_SMB=m
CONFIG_RMI4_F34=y
CONFIG_HID_A4TECH=m
CONFIG_HID_APPLE=m
CONFIG_HID_BELKIN=m
CONFIG_HID_CHERRY=m
CONFIG_HID_CYPRESS=m
CONFIG_DRAGONRISE_FF=y
CONFIG_HID_EZKEY=m
CONFIG_HOLTEK_FF=y
CONFIG_HID_ITE=m
CONFIG_HID_KENSINGTON=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_MONTEREY=m
CONFIG_NINTENDO_FF=y
CONFIG_NVIDIA_SHIELD_FF=y
CONFIG_PANTHERLORD_FF=y
CONFIG_STEAM_FF=y
CONFIG_GREENASIA_FF=y
CONFIG_SMARTJOYPLUS_FF=y
CONFIG_THRUSTMASTER_FF=y
CONFIG_ZEROPLUS_FF=y
CONFIG_HID_SENSOR_CUSTOM_SENSOR=m
CONFIG_RTC_DRV_HID_SENSOR_TIME=m
CONFIG_IIO_BUFFER_CB=m
CONFIG_IIO_BUFFER_DMA=m
CONFIG_IIO_BUFFER_DMAENGINE=m
CONFIG_IIO_BUFFER_HW_CONSUMER=m
CONFIG_HID_SENSOR_PROX=m
CONFIG_IIO_INTERRUPT_TRIGGER=m
CONFIG_IIO_SYSFS_TRIGGER=m
CONFIG_HID_SENSOR_PRESS=m
CONFIG_CFI=y
CONFIG_CFI_ICALL_NORMALIZE_INTEGERS=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_DM_VERITY=m
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_NTSYNC=m
CONFIG_ZRAM_BACKEND_842=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_NTFS3_FS=m
CONFIG_SND_USB_AUDIO_MIDI_V2=y
CONFIG_USB_SERIAL_SIMPLE=m
CONFIG_USB_UAS=m
CONFIG_BPF_LSM=y
CONFIG_KPROBES=y
CONFIG_BLK_DEV_UBLK=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
CONFIG_CACHEFILES=m
CONFIG_CRYPTO_CAMELLIA=m
CONFIG_FSCACHE=y
CONFIG_NFS_FSCACHE=y
CONFIG_NFSD=m
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_NFSD_PNFS=y
CONFIG_NFSD_BLOCKLAYOUT=y
CONFIG_NFSD_SCSILAYOUT=y
CONFIG_NFSD_V4_2_INTER_SSC=y
CONFIG_RPCSEC_GSS_KRB5_ENCTYPES_AES_SHA2=y
CONFIG_RPCSEC_GSS_KRB5_ENCTYPES_CAMELLIA=y
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_SECURITY_DMESG_RESTRICT=y

# Module compression config changed in c7ff693fa209 ("module: Split
# modules_install compression and in-kernel decompression")
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# Enable iptables which is still checked
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Irrelevant subsystems
CONFIG_ACPI=n
CONFIG_PCI=n

# Irrelevant platforms
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_BST=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_STM32=n

# Irrelevant drivers
#
# These can be disabled with the confidence that it is impossible to use these
# drivers on SDM670 except on an unsupported device.
CONFIG_ACPI_CPPC_CPUFREQ=n
CONFIG_AMD_XGBE=n
CONFIG_ARM64_PLATFORM_DEVICES=n
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=n
